{
  "brand": {
    "$type": "color",
    "teal": { "$value": "#00766c" },
    "ink": { "$value": "#14212b" },
    "coral": { "$value": "#d9480f" },
    "mist": { "$value": "#eef4f3" }
  },
  "color": {
    "$type": "color",
    "accent": { "$value": "{brand.teal}", "$extensions": { "rustnative.host": "accent" } },
    "on-accent": { "$value": "#ffffff", "$extensions": { "rustnative.host": "on-accent" } },
    "danger": { "$value": "{brand.coral}" },
    "on-danger": { "$value": "#ffffff" },
    "surface": { "$value": "#ffffff", "$extensions": { "rustnative.host": "surface" } },
    "on-surface": { "$value": "{brand.ink}", "$extensions": { "rustnative.host": "on-surface" } }
  },
  "radius": { "$type": "dimension", "card": { "$value": "10px" } }
}
